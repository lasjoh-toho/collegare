# Beispiel; echte Werte nur auf der VM (z. B. /etc/collegare/collegare.env), nie ins Repository
PORT=8787
HOST=127.0.0.1
APP_URL=https://server.schule.de/collegare
DATABASE_URL=mariadb://collegare:PASSWORT@127.0.0.1:3306/collegare
